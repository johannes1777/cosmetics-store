# Copy this file to ".env.local" and fill in YOUR values.
# ".env.local" is ignored by git, so it is never uploaded to GitHub.
#
# Only these two PUBLIC values belong in browser code. Anything starting with
# VITE_ is visible to every visitor, so NEVER put a secret key here
# (no key starting sb_secret_, no "service_role" key).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
